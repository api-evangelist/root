          "name": "Trigger a custom notification event",
          "request": {
            "name": "Trigger a custom notification event",
            "description": {
              "content": "Queue a custom notification request (or first queue policy documents to be generated if there are email attachments). A `200 (Success)` response does not indicate that the notification was sent successfully. Please refer to the [custom notification events](doc:custom-notification-events) guide.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "custom-notification-events",
                ":custom_event_key",
                "trigger"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "custom_event_key",
                  "description": "(Required) The key identifiying the custom notification event."
                }
              ]
            },
            "header": [
