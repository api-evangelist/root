          "request": {
            "name": "Download file",
            "description": {
              "content": "Download a file by its unique file ID. Files are typically attachments that have been uploaded to the system and associated with various entities like policies, claims, applications, etc.\n\nNote: A filename can optionally be appended to the URL for readability (e.g., `/apps/{organization_id}/files/download/{file_id}/report.pdf`), but it is not used for file identification.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "apps",
                ":organization_id",
                "files",
                "download",
                ":file_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "organization_id",
                  "description": "(Required) The unique identifier of the organization."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "file_id",
                  "description": "(Required) The unique identifier of the file to download."
                }
              ]
            },
            "header": [
