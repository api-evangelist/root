{
  "opencollection": "1.0.0",
  "info": {
    "name": "Root Applications Complaints API",
    "version": "1.0.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
