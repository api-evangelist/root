        {
          "id": "4bae2176-f4d9-4feb-a87a-cda0fca7d17b",
          "name": "Lookup an Embed session",
          "request": {
            "name": "Lookup an Embed session",
            "description": {
              "content": "This endpoint allows you to retrieve an existing Embed session using identification details and a `product_module_key`. The session is retrieved based on the customer's identification type, number, and associated organization information. This supports use cases where an organization needs to look up session details securely using authentication.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "embed-sessions",
                "lookup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_module_key\": \"<string>\",\n  \"identification_type\": \"<string>\",\n  \"identification_number\": \"<string>\",\n  \"identification_country\": \"<string>\",\n  \"registration_number\": \"<string>\",\n  \"embed_session_id\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "e81317a8-f428-4ce4-8b53-600ba33e6184",
