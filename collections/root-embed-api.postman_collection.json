      "item": [
        {
          "id": "6f0392e1-7d11-491b-9af8-e9eb42b39000",
          "name": "Create an embed URL",
          "request": {
            "name": "Create an embed URL",
            "description": {
              "content": "Generates a unique URL to initiate an Embed session, which allows customers to access various workflows within Embed. This URL can be used in either authenticated or unauthenticated flows. The authenticated flow is recommended for scenarios where the customer's identity is known, enabling seamless access to Embed’s Management and Sales workflows. The unauthenticated flow, intended for use in Embed | Sales only, is suited for scenarios where customer identity is not known upfront. See the [Embed implementation guide](https://docs.rootplatform.com/docs/embed-implementation) for detailed steps on integrating Embed into your customer journey.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "embed",
                "url"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "organization_id",
                  "value": "<string>",
                  "description": "(Required) The unique identifier of the organization."
                },
                {
                  "disabled": false,
                  "key": "environment",
                  "value": "<string>",
                  "description": "(Required) Specifies the environment for the embed session (e.g., sandbox, production)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_module_key\": \"<string>\",\n  \"unauthenticated\": \"<boolean>\",\n  \"custom_path\": \"<string>\",\n  \"prefill_data\": {\n    \"application\": \"<object>\",\n    \"payment\": \"<object>\",\n    \"personal_details\": \"<object>\",\n    \"pre_payment_details_consent\": \"<boolean>\",\n    \"pre_personal_details_consent\": \"<boolean>\",\n    \"quote\": \"<object>\",\n    \"screening_questions\": [\n      \"<object>\",\n      \"<object>\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "edd99fba-e718-4e00-8b2d-1038af885d33",
              "name": "Embed URL created successfully.",
              "originalRequest": {
